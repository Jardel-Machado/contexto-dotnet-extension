{
  "name": "create-context",
  "displayName": "vscode-create-context",
  "publisher": "jardel-machado",
  "description": "Gere automaticamente a estrutura completa de um novo contexto em projetos .NET com apenas um clique. Ideal para arquiteturas em camadas!",
  "version": "0.0.2",
  "repository": {
    "type": "git",
    "url": "https://github.com/Jardel-Machado/contexto-dotnet-extension.git"
  },
  "engines": {
    "vscode": "^1.99.0"
  },
  "icon": "logo.png",
  "activationEvents": [
    "onCommand:extension.createContext"
  ],
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "extension.createContext",
        "title": "Criar Novo Contexto .NET"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "extension.createContext"
        }
      ],
      "commandPalette": [
        {
          "command": "extension.createContext"
        }
      ],
      "editor/title": [
        {
          "command": "extension.createContext",
          "group": "navigation"
        }
      ],
      "editor/context": [
        {
          "command": "extension.createContext",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.99.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "20.x",
    "@typescript-eslint/eslint-plugin": "^8.28.0",
    "@typescript-eslint/parser": "^8.28.0",
    "eslint": "^9.23.0",
    "esbuild": "^0.25.1",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.8.2",
    "@vscode/test-cli": "^0.0.10",
    "@vscode/test-electron": "^2.4.1"
  }
}